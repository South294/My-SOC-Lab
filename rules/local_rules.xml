<group name="local,custom_soc_lab,">

  <rule id="100100" level="10">
    <if_sid>31100, 31101, 31103, 31106, 31108</if_sid>
    <url type="pcre2">(?i)(\%27|\'|--|union\s+select|select\s+.*\s+from|or\s+1\=1|waitfor\s+delay)</url>
    <description>Web Attack: SQL Injection attempt detected on URI</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <id>^403$</id>
    <description>WAF Action: SQL Injection attempt blocked (HTTP 403)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100102" level="12">
    <if_sid>100100</if_sid>
    <id>^200$</id>
    <description>CRITICAL: SQL Injection returned HTTP 200 OK</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100200" level="5">
    <if_sid>5710, 5716</if_sid>
    <description>SSH: Authentication failure</description>
  </rule>

  <rule id="100201" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>Brute Force: Multiple SSH authentication failures from single IP</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>

  <rule id="100202" level="13">
    <if_sid>5715</if_sid>
    <if_matched_sid>100201</if_matched_sid>
    <same_source_ip />
    <description>CRITICAL: Successful SSH login after brute force from same IP</description>
    <mitre><id>T1110.001</id><id>T1078</id></mitre>
  </rule>

  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="EventID">^1$|^13$</field>
    <description>Sysmon Dataset Event ingested via JSON replay</description>
  </rule>

  <rule id="100301" level="10">
    <if_sid>100300</if_sid>
    <field name="EventID">^1$</field>
    <field name="Image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)(\s+-(e|en|enc|encoded|encodedcommand)\s+|-executionpolicy\s+bypass)</field>
    <description>Defense Evasion: Suspicious PowerShell execution detected</description>
    <mitre><id>T1027</id><id>T1059.001</id></mitre>
  </rule>

  <rule id="100302" level="10">
    <if_sid>100300</if_sid>
    <field name="EventID">^13$</field>
    <field name="TargetObject" type="pcre2">(?i)CurrentVersion\\Run</field>
    <description>Persistence: Registry Run Key modification detected</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="100401" level="0">
    <if_sid>100301</if_sid>
    <user type="pcre2">(?i)^DOMAIN\\svc_backup$</user>
    <field name="ParentImage" type="pcre2">(?i)\\svchost\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)-File\s+\\?"C:\\Program Files\\IT-Management\\Backup_Routine\.ps1\\?"$</field>
    <description>Tuning: Whitelist authorized IT Backup Service account</description>
  </rule>

</group>
