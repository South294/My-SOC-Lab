<group name="local,syslog,sshd,">

  <rule id="100001" level="10">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Authentication Failure: Multiple SMB logon failures detected (Possible Brute Force)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100002" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)vssadmin\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)delete\s+shadows</field>
    <description>Ransomware Activity: Shadow Copies deletion attempt detected</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <rule id="100003" level="10">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CurrentVersion\\\\Run</field>
    <description>Persistence: Suspicious modification of Registry Run Key</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <rule id="100004" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s+-(e|en|enc|encoded)(c|co|com|comm|comma|comman|command)?\s+</field>
    <description>Defense Evasion: PowerShell execution with encoded command detected</description>
    <mitre>
      <id>T1027</id>
    </mitre>
  </rule>

  <rule id="100005" level="11">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Temp\\|\\Downloads\\|\\Public\\</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(exe|dll|bat|ps1|vbs|scr)$</field>
    <description>Suspicious File Download: Executable file created in temporary/public directory</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

</group>
